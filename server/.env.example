# SOP Management System - Environment Configuration

# Application Environment: "development" | "production" | "test"
APP_ENV=development

# Port for Backend REST API
PORT=4000

# Client Application URL (for CORS & Cookie verification)
CLIENT_URL=http://localhost:5173

# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./sop_dev.db"

# JWT / Session Secret (Must be 32+ characters strong secret in production)
JWT_SECRET=sop_enterprise_jwt_secret_minimum_32_characters_dev_key_2026

# Demo Accounts Control (MUST BE false IN PRODUCTION)
# When false or APP_ENV=production, demo routes, demo logins, and demo seed are strictly blocked
ENABLE_DEMO_ACCOUNTS=true

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# Max Upload Size in Bytes (default 15MB)
MAX_UPLOAD_SIZE=15728640

# SMTP Email Configuration (Optional - for automated notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NKB SOP System <sop-notifications@nkb.local>"
